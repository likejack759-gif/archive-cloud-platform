# Copy to .env and replace every placeholder. Never commit the real .env.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SESSION_HTTPS_ONLY=true
PORT=8000
MAX_UPLOAD_MB=500

# PostgreSQL: keep POSTGRES_PASSWORD URL-safe (letters/numbers are easiest).
POSTGRES_USER=archive_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_URL_SAFE_PASSWORD
POSTGRES_DB=archive_platform
DATABASE_URL=postgresql://archive_app:REPLACE_WITH_LONG_URL_SAFE_PASSWORD@db:5432/archive_platform

# Required S3-compatible object storage. These values come from your storage provider.
AWS_ENDPOINT_URL_S3=https://REPLACE_WITH_YOUR_S3_ENDPOINT
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_KEY
AWS_REGION=us-east-2
S3_BUCKET=archive-files
