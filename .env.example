# Copy to .env. Replace every placeholder; never commit real credentials.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# PostgreSQL connection string for this application.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME

# S3-compatible object storage (SeaweedFS S3 gateway or another compatible service).
AWS_ENDPOINT_URL_S3=http://S3_HOST:8333
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=archive-files

MAX_UPLOAD_MB=2048
SESSION_HTTPS_ONLY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
REQUEST_RATE_LIMIT=120
REQUEST_RATE_WINDOW_SECONDS=60

# Optional scanner endpoint. If unset or unavailable, scanning is not considered clean;
# keep resource approval blocked until the scanner is configured and reachable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
