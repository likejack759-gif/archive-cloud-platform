# Copy to .env. Use long random secrets; keep .env out of version control.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
DB_PASSWORD=REPLACE_WITH_STRONG_ALPHANUMERIC_DATABASE_PASSWORD
POSTGRES_DB=archive
POSTGRES_USER=archive

# These must exactly match the accessKey/secretKey in seaweedfs-s3.json.
MINIO_ROOT_USER=REPLACE_WITH_RANDOM_S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_S3_SECRET_KEY
S3_BUCKET=archive-files
AWS_REGION=us-east-1

MAX_UPLOAD_MB=2048
MAX_USER_STORAGE_MB=10240
MAX_PLATFORM_STORAGE_GB=50
LOGIN_FAILURE_LIMIT=10
LOGIN_WINDOW_MINUTES=15
# Add the actual reverse-proxy peer IP only if it is stable and trusted.
TRUSTED_PROXY_IPS=127.0.0.1,::1
SESSION_HTTPS_ONLY=true
APP_BIND_ADDRESS=127.0.0.1

CLAMAV_TIMEOUT_SECONDS=180
MAX_ARCHIVE_MEMBERS=20000
MAX_ARCHIVE_MEMBER_BYTES=2147483648
